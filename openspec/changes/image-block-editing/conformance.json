      "anchors": [
        {
          "id": "A-1.1",
          "claim": "图片块手柄的图标名",
          "kind": "exact",
          "assert": "\"ImageOutlined\"",
          "source": "#649 第 5 项 / design D9"
        },
        {
          "id": "A-1.2",
          "claim": "高亮块手柄的图标名",
          "kind": "exact",
          "assert": "\"CalloutOutlined\"",
          "source": "#649 第 8 项 / design D9"
        },
        {
          "id": "A-1.3",
          "claim": "图片块菜单结构动作可见",
          "kind": "exact",
          "assert": "\"true\"",
          "source": "#649 第 5 项 / design D9"
        }
      ]
    },
    {
      "id": "R-2",
      "text": "尺寸/对齐/描述载体",
      "anchors": [
        {
          "id": "A-2.1",
          "claim": "改尺寸后源码出现属性且无 HTML 注释",
          "kind": "exact",
          "assert": "\"true\"",
          "source": "#649 第 1 项 / design D1"
        },
        {
          "id": "A-2.2",
          "claim": "括号路径拖宽后路径完整",
