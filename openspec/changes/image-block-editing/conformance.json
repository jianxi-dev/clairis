          "assert": "\"true\"",
          "source": "真机复现 / design D2"
        },
        {
          "id": "A-2.3",
          "claim": "旧 `<!--w=220-->` 文档的渲染宽度",
          "kind": "exact",
          "assert": "220",
          "source": "#649 第 1 项 / design D1"
        }
      ]
    },
    {
      "id": "R-3",
      "text": "选中态与工具条",
      "anchors": [
        {
          "id": "A-3.1",
          "claim": "点击后选中图片数量",
          "kind": "exact",
          "assert": "1",
          "source": "截图 1 / design D4"
        },
        {
          "id": "A-3.2",
          "claim": "选中态四角圆点数量",
          "kind": "exact",
          "assert": "4",
          "source": "截图 1 / design D4"
        },
        {
          "id": "A-3.3",
          "claim": "工具条按钮数量",
