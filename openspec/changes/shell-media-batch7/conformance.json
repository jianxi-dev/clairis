      "id": "R-1",
      "text": "主题弹层生命周期与主题入口",
      "anchors": [
        {
          "id": "A-1.1",
          "claim": "指针从主题按钮缓慢移动到面板项上停留 500ms 后面板仍可见",
          "kind": "state-machine",
          "assert": "\"true\"",
          "source": "spec 状态栏"
        },
        {
          "id": "A-1.2",
          "claim": "连续单击主题图标 4 次后的主题序列",
          "kind": "state-machine",
          "assert": "\"light → dark → warm → system\"",
          "source": "spec 状态栏"
        },
        {
          "id": "A-1.3",
          "claim": "主题面板的 role 属性值",
          "kind": "exact",
          "assert": "\"menu\"",
          "source": "spec 状态栏"
        },
        {
          "id": "A-1.4",
          "claim": "宽度调整面板按 Esc 后可见面板数量",
          "kind": "exact",
          "assert": "0",
          "source": "spec 状态栏"
        },
        {
          "id": "A-1.5",
          "claim": "状态栏隐藏态经底部热区唤出后，指针移入主题面板时面板仍可见",
          "kind": "state-machine",
          "assert": "\"true\"",
          "source": "design D-1"
        }
      ]
    },
