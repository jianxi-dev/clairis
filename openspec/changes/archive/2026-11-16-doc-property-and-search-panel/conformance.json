{
  "change": "doc-property-and-search-panel",
  "requirements": [
    {
      "id": "R-1",
      "text": "P-1 面板落位与三模式",
      "anchors": [
        {
          "id": "A-1.1",
          "claim": "三模式往返",
          "kind": "state-machine",
          "assert": "打开含 frontmatter 文档依次切换到 预览→编辑→源码：面板分别变为只读渲染/展开可折叠/不渲染，切回后面板数据与选中状态无残留丢失",
          "source": "prototype#面板三模式"
        },
        {
          "id": "A-1.2",
          "claim": "面板位于内容区顶部正文上方",
          "kind": "perceptual",
          "assert": "打开含 frontmatter 文档，正文上方出现带字段行与标签的属性面板（B 态字段行 5 列网格 16/30/92/1fr/18px 对齐）",
          "source": "baseline/panel-a-edit.png"
        }
      ]
    },
    {
      "id": "R-2",
      "text": "P-2 显示样式两态与显隐配置",
      "anchors": [
        {
          "id": "A-2.1",
          "claim": "样式切换即时生效",
          "kind": "exact",
          "assert": "设置把样式从 A 切换到 B：面板立即变为 B 双列形态，字段内容与顺序不变",
          "source": "prototype#A/B两态"
        },
        {
          "id": "A-2.2",
          "claim": "⌘⇧Y 显隐",
          "kind": "exact",
          "assert": "按 ⌘⇧Y 面板隐藏并显示恢复提示，再按恢复；不修改文档内容",
          "source": "决策#建议C"
        },
        {
          "id": "A-2.3",
          "claim": "B 态 5 列网格",
          "kind": "perceptual",
          "assert": "B 态每行 5 列网格对齐：手柄 16px / 类型 30px / 名称 92px / 值 1fr / 删除 18px",
          "source": "baseline/panel-b-edit.png"
        }
      ]
    },
    {
      "id": "R-3",
      "text": "P-3 字段类型系统与智能编辑",
      "anchors": [
        {
          "id": "A-3.1",
          "claim": "数字千分位仅显示层",
          "kind": "exact",
          "assert": "值 1234567 显示 `1,234,567`，编辑器与 YAML 源码保持 `1234567`",
          "source": "prototype#千分位"
