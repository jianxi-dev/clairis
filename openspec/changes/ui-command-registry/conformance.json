{
  "change": "ui-command-registry",
  "requirements": [
    {
      "id": "R-1",
      "text": "命令注册表",
      "anchors": [
        {
          "id": "A-1.1",
          "claim": "点击轮盘「加粗」后编辑态源码含加粗标记",
          "kind": "exact",
          "assert": "\"**\"",
          "source": "design D1 / 用户需求 9"
        },
        {
          "id": "A-1.2",
          "claim": "内置命令 `bold` 注册命中",
          "kind": "exact",
          "assert": "\"true\"",
          "source": "design D1"
        },
        {
          "id": "A-1.3",
          "claim": "未注册 `commandId` 且无 `run` 的项在轮盘筛选中出现次数",
          "kind": "exact",
          "assert": "\"0\"",
          "source": "design D1"
        }
      ]
    },
    {
      "id": "R-2",
      "text": "扇区数据面",
      "anchors": [
        {
          "id": "A-2.1",
          "claim": "配置去掉 `columns` 后轮盘根扇区数量",
          "kind": "exact",
          "assert": "\"7\"",
          "source": "design D2"
        },
        {
          "id": "A-2.2",
          "claim": "配置去掉 `columns` 后 `.sr-sector` 的 `data-sector` 集合含 `columns` 的次数",
          "kind": "exact",
          "assert": "\"0\"",
          "source": "design D2"
        },
        {
          "id": "A-2.3",
          "claim": "配置写入未知 id 后轮盘根扇区数量（回落默认）",
          "kind": "exact",
          "assert": "\"8\"",
          "source": "design D3"
        },
        {
          "id": "A-2.4",
          "claim": "配置写入空数组时保存结果",
          "kind": "exact",
          "assert": "\"rejected\"",
          "source": "design D3"
        }
      ]
    },
    {
      "id": "R-3",
      "text": "设置面与回滚",
      "anchors": [
        {
          "id": "A-3.1",
          "claim": "设置中取消勾选「分栏」后轮盘根扇区数量",
          "kind": "exact",
          "assert": "\"7\"",
          "source": "design D4"
        },
        {
          "id": "A-3.2",
          "claim": "取消勾选并重启后轮盘根扇区数量",
          "kind": "exact",
          "assert": "\"7\"",
          "source": "design D4"
        },
        {
          "id": "A-3.3",
          "claim": "点「恢复默认」后轮盘根扇区数量",
          "kind": "exact",
          "assert": "\"8\"",
          "source": "design D4"
        },
        {
          "id": "A-3.4",
          "claim": "空数组被拒后 `user/settings.json` 中 `rouletteSectors` 的值",
          "kind": "exact",
          "assert": "\"unchanged\"",
          "source": "design D3"
        }
      ]
    }
  ]
}