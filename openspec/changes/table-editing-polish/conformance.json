{
  "change": "table-editing-polish",
  "requirements": [
    {
      "id": "R-1",
      "text": "单元格手柄统一与定位",
      "anchors": [
        {
          "id": "A-1.1",
          "claim": "手柄计算样式的 `border-radius`",
          "kind": "exact",
          "assert": "3px",
          "source": "#738 手柄段第 4 项 / design D1"
        },
        {
          "id": "A-1.2",
          "claim": "手柄纵向中心与单元格纵向中心差上限（px）",
          "kind": "exact",
          "assert": "2",
          "source": "#738 手柄段第 2 项 / design D1"
        },
        {
          "id": "A-1.3",
          "claim": "悬停表头单元格时手柄节点数",
          "kind": "exact",
          "assert": "0",
          "source": "#738 手柄段第 3 项 / design D1"
        },
        {
          "id": "A-1.4",
          "claim": "空/非空单元格手柄 `data-icon` 值集合大小",
          "kind": "exact",
          "assert": "1",
          "source": "#738 手柄段第 1 项 / design D1"
        },
        {
          "id": "A-1.5",
          "claim": "手柄位置与单元格左边框线",
          "kind": "state-machine",
          "assert": "悬停→手柄在边框线外侧且不覆盖单元格文本，离开→隐藏",
          "source": "#738 手柄段第 2 项 / design D1"
        }
      ]
    },
    {
      "id": "R-2",
      "text": "行列插入圆点",
      "anchors": [
        {
          "id": "A-2.1",
          "claim": "指针滑入表格→圆点出现，离开→隐藏",
          "kind": "state-machine",
          "assert": "出现→隐藏",
          "source": "#738 行列段 / design D2"
        },
        {
          "id": "A-2.2",
          "claim": "悬停圆点后该圆点变为「+」图标（data-icon=Add 的热点数）",
          "kind": "exact",
          "assert": "1",
          "source": "#738 行列段 / design D2"
        },
        {
          "id": "A-2.3",
          "claim": "圆点矩形与表格矩形关系",
          "kind": "state-machine",
          "assert": "滑入→圆点矩形在表格矩形之外（距离边框 0-2px）",
          "source": "#738 行列段 / design D2"
        },
        {
          "id": "A-2.4",
          "claim": "点击列间圆点气泡「插入列」后表格列数增量",
          "kind": "exact",
          "assert": "1",
          "source": "#738 行列段 / design D2"
        },
        {
          "id": "A-2.5",
          "claim": "点击行间圆点气泡「删除行」后表格行数减量",
          "kind": "exact",
          "assert": "1",
          "source": "#738 行列段 / design D2"
        }
      ]
    },
    {
      "id": "R-3",
      "text": "单元格斜杠上下文",
      "anchors": [
        {
          "id": "A-3.1",
          "claim": "单元格输入 / 后菜单矩形与单元格矩形最近距离上限（px）",
          "kind": "exact",
          "assert": "8",
          "source": "#738 斜杠段 / design D3+D4"
        },
        {
          "id": "A-3.2",
          "claim": "打开菜单后焦点所在元素",
          "kind": "exact",
          "assert": "菜单打开→焦点仍在单元格输入框（activeElement 为输入框）",
          "source": "#738 斜杠段 / design D4"
        },
        {
          "id": "A-3.3",
          "claim": "打开菜单后在文档（表格外）新增的 \"/\" 字符数",
          "kind": "exact",
          "assert": "0",
          "source": "#738 斜杠段（现状 4 个）/ design D4"
        },
        {
          "id": "A-3.4",
          "claim": "Esc 关闭后单元格文本残留 \"/\" 数",
          "kind": "exact",
          "assert": "0",
          "source": "#738 斜杠段 / design D4"
        },
        {
          "id": "A-3.5",
          "claim": "选单后插入内容与目标单元格",
          "kind": "state-machine",
          "assert": "选单→插入内容出现在目标单元格可见文本中（源码单元格文本含插入值）",
          "source": "#738 斜杠段 / design D4"
        }
      ]
    },
    {
      "id": "R-4",
      "text": "容器接入（分栏/高亮块）",
      "anchors": [
        {
          "id": "A-4.1",
          "claim": "分栏内容区输入 / 后打开的统一菜单节点数",
          "kind": "exact",
          "assert": "1",
          "source": "#738 分栏段 / design D4+D7"
        },
        {
          "id": "A-4.2",
          "claim": "分栏内容区选单后插入内容与分栏文本",
          "kind": "state-machine",
          "assert": "选单→插入内容出现在分栏内容文本中（源码分栏体含插入值）",
          "source": "#738 分栏段 / design D4"
        },
        {
          "id": "A-4.3",
          "claim": "高亮块内容区输入 / 后打开的统一菜单节点数",
          "kind": "exact",
          "assert": "1",
          "source": "#738 高亮块段 / design D6"
        },
        {
          "id": "A-4.4",
          "claim": "高亮片段命令在统一菜单中的可见数下限",
          "kind": "exact",
          "assert": "1",
          "source": "#738 高亮块段 / design D6"
        },
        {
          "id": "A-4.5",
          "claim": "悬停分栏内容区出现「+」手柄数",
          "kind": "exact",
          "assert": "1",
          "source": "#738 分栏段 / design D7"
        },
        {
          "id": "A-4.6",
          "claim": "独立片段菜单（callout-insert 容器）节点数",
          "kind": "exact",
          "assert": "0",
          "source": "#738 高亮块段 / design D6"
        }
      ]
    },
    {
      "id": "R-5",
      "text": "菜单定位与命令安全集",
      "anchors": [
        {
          "id": "A-5.1",
          "claim": "贴近视口底部的单元格菜单矩形是否完整落在视口内",
          "kind": "exact",
          "assert": "贴底→翻转或夹取，菜单矩形底边 ≤ 视口底边（px 差 ≥0）",
          "source": "#738 菜单段 / design D3"
        },
        {
          "id": "A-5.2",
          "claim": "单元格上下文菜单中块级命令（表格/分栏/代码围栏）数量",
          "kind": "exact",
          "assert": "0",
          "source": "#738 斜杠段 / design D5"
        },
        {
          "id": "A-5.3",
          "claim": "分栏上下文菜单中「表格」命令数量",
          "kind": "exact",
          "assert": "1",
          "source": "#738 斜杠段 / design D5"
        },
        {
          "id": "A-5.4",
          "claim": "上下文菜单打开后编辑器主光标选区是否被改变",
          "kind": "exact",
          "assert": "打开菜单→主光标选区不变（选区前后相等，偏移差 0）",
          "source": "#738 斜杠段 / design D4"
        }
      ]
    }
  ]
}